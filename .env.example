# ─── Karthikeyan Portfolio Backend – Environment Variables ───────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# Resend API Key — get from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# The email address WHERE you want to receive contact form submissions
CONTACT_RECEIVER_EMAIL=karthikeyan@yourdomain.com

# The verified sender email from your Resend domain
# Must be from a domain verified in your Resend dashboard
RESEND_FROM_EMAIL=portfolio@yourdomain.com

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:4200

# Server port
PORT=5000

# ASP.NET environment (Development | Production)
ASPNETCORE_ENVIRONMENT=Development
